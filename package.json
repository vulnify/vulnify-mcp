{
  "name": "@vulnify/mcp",
  "version": "0.1.1",
  "description": "Vulnify MCP server: runtime authorization for AI agents. Check an action, record a decision, and read policies.",
  "keywords": [
    "vulnify",
    "mcp",
    "authorization",
    "security",
    "ai-agents",
    "model-context-protocol"
  ],
  "homepage": "https://docs.vulnify.io",
  "bugs": {
    "url": "https://github.com/vulnify/vulnify-mcp/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vulnify/vulnify-mcp.git"
  },
  "mcpName": "io.vulnify/mcp",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "vulnify-mcp": "dist/cli.js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsx --test src/**/*.spec.ts",
    "test:live": "tsx scripts/live-smoke.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "check:package": "publint && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "publint": "^0.3.15",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
